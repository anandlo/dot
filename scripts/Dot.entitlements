<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The hardened runtime, which every Dot signature uses, refuses audio input
	  to a process that does not declare it, before the privacy prompt would
	  appear. Without this entitlement, AVFoundation fails and the Microphone
	  switch in System Settings cannot help.

	  Dot is not sandboxed, so it needs no other entitlement: file access, the
	  network and the Accessibility API that pastes the transcript are not
	  gated by the runtime.
	-->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
