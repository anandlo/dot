.build/
build/
# dist/ is build output, except the Homebrew tap contents: the cask and its
# instructions are the source of truth for what gets published to the tap, so
# they are tracked and reviewed with the code.
dist/*
!dist/homebrew/
.swiftpm/
*.xcodeproj
*.xcworkspace
.scratch/
.DS_Store
*/.DS_Store
*/**/.DS_Store
*.log
__pycache__/
.taste-skill/
# Local-only font comparison: ITF Free Font License permits self-hosting for the
# owner's own use but forbids redistribution, so these files must never be staged.
/output/playwright/font-study/
# The app's typeface. Same licence: it may be embedded in the app but not
# redistributed, so the binary is fetched by scripts/fetch-fonts.sh and never
# committed. Resources/Fonts/README.md carries the provenance and the terms.
Resources/Fonts/*.ttf
